# Default: local workbench without login, bind API to 127.0.0.1 only.
LOCAL_ONLY=1
# Public cloud app: PUBLIC_ACCESS=1, LOCAL_ONLY=0; private SESSION_SECRET >=32 chars.
PUBLIC_ACCESS=0
ALLOWED_ORIGINS=[]
# Only needed for explicitly enabled legacy authenticated deployments (LOCAL_ONLY=0).
ACCESS_PASSCODE=
SESSION_SECRET=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
# cache accepts bundled samples only; live requires vision configuration too.
OCR_MODE=cache
# Relative paths are resolved under src/.
DATA_DIR=data
MAX_UPLOAD_MB=10
# Local default 100; ModelScope demo uses a private DAILY_OCR_LIMIT=1000.
# Shared across visitors; attempted HTTP calls incl. retries, resets 00:00 UTC.
DAILY_OCR_LIMIT=100
VLM_ENABLED=0
VLM_BASE_URL=https://api-inference.modelscope.cn/v1
VLM_MODEL=
VLM_API_KEY=
VLM_TIMEOUT_S=60
# Per-image zoning wall-clock deadline; no automatic retry beyond this budget.
ZONING_TIMEOUT_S=300
DAILY_VLM_LIMIT=100
CLAIM_PRECHECK_ENABLED=1
CLAIM_PRECHECK_MODEL=gpt-6.1-sol
DAILY_CLAIM_PRECHECK_LIMIT=10
WORKER_POLL_S=1
