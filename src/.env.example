# Required: set a shared passcode and a separate random session secret.
ACCESS_PASSCODE=
SESSION_SECRET=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
# cache accepts bundled samples only; live enables Baidu OCR for new uploads.
OCR_MODE=cache
# Relative paths are resolved under src/.
DATA_DIR=data
MAX_UPLOAD_MB=10
DAILY_OCR_LIMIT=100
VLM_ENABLED=0
VLM_BASE_URL=https://api-inference.modelscope.cn/v1
VLM_MODEL=
VLM_API_KEY=
VLM_TIMEOUT_S=60
DAILY_VLM_LIMIT=20
WORKER_POLL_S=1
